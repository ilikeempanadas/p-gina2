<%- include("partials/header", {title}) %>
<section class="dashboard-head"><div><span class="eyebrow">CENTRO DE CONTROL</span><h1>Administración <span>general.</span></h1><p>Gestiona accesos, asignaciones y la información de la plataforma.</p></div></section>
<div class="stats-grid"><article class="stat-card"><span class="stat-icon">♙</span><small>Usuarios</small><strong><%= stats.users %></strong><span class="stat-caption">Cuentas registradas</span></article><article class="stat-card"><span class="stat-icon purple-icon">▤</span><small>Cursos</small><strong><%= stats.courses %></strong><span class="stat-caption">Cursos configurados</span></article><article class="stat-card"><span class="stat-icon orange-icon">✓</span><small>Calificaciones</small><strong><%= stats.grades %></strong><span class="stat-caption">Registros académicos</span></article></div>
<section class="panel"><div class="panel-heading"><div><h2>Crear usuario</h2><p>Asigna el rol correspondiente. Las contraseñas se guardan con hash.</p></div></div>
<form method="post" action="/administrador/usuarios/guardar" class="admin-form" data-validate><label>Nombre completo<input name="full_name" required minlength="2" maxlength="120" placeholder="Nombre y apellidos"></label><label>Correo electrónico<input name="email" type="email" required maxlength="180" placeholder="persona@colegio.edu"></label><label>Rol<select name="role" required><option value="estudiante">Estudiante</option><option value="docente">Docente</option><option value="administrador">Administrador</option></select></label><label>Contraseña temporal<input name="password" type="password" required minlength="8" placeholder="Mínimo 8 caracteres"></label><button class="btn btn-primary" type="submit">＋ Crear usuario</button></form></section>
<section class="panel"><div class="panel-heading"><div><h2>Usuarios registrados</h2><p>Edita roles o desactiva cuentas cuando sea necesario.</p></div></div><div class="table-wrap"><table><thead><tr><th>Usuario</th><th>Rol</th><th>Estado</th><th>Actualizar datos</th><th>Acceso</th></tr></thead><tbody><% users.forEach(u => { %><tr><td><b><%= u.full_name %></b><small class="table-sub"><%= u.email %></small></td><td><span class="role-pill"><%= u.role %></span></td><td><span class="status-dot <%= u.active?'status-active':'status-inactive' %>"></span><%= u.active?'Activo':'Desactivado' %></td><td><form method="post" action="/administrador/usuarios/guardar" class="edit-user-form" data-validate><input type="hidden" name="id" value="<%= u.id %>"><input name="full_name" value="<%= u.full_name %>" required maxlength="120" aria-label="Nombre"><input name="email" value="<%= u.email %>" type="email" required aria-label="Correo"><select name="role" aria-label="Rol"><option value="estudiante" <%= u.role==='estudiante'?'selected':'' %>>Estudiante</option><option value="docente" <%= u.role==='docente'?'selected':'' %>>Docente</option><option value="administrador" <%= u.role==='administrador'?'selected':'' %>>Admin</option></select><input name="password" type="password" minlength="8" placeholder="Nueva contraseña (opcional)" aria-label="Nueva contraseña"><button class="btn btn-small btn-secondary" type="submit">Guardar</button></form></td><td><% if (u.id !== user.id) { %><form method="post" action="/administrador/usuarios/<%= u.id %>/estado"><input type="hidden" name="active" value="<%= !u.active %>"><button class="btn btn-small <%= u.active?'btn-danger':'btn-secondary' %>" type="submit"><%= u.active?'Desactivar':'Activar' %></button></form><% } else { %><span class="muted">Tu cuenta</span><% } %></td></tr><% }) %></tbody></table></div></section>
<section class="admin-bottom-grid"><div class="panel"><div class="panel-heading"><div><h2>Crear curso</h2><p>Asigna una materia a un docente activo.</p></div></div><form method="post" action="/administrador/cursos/guardar" class="form-stack" data-validate><label>Nombre del curso</label><input name="name" required maxlength="120" placeholder="Ej. Ciencias Naturales"><label>Código</label><input name="code" required minlength="2" maxlength="20" pattern="[A-Za-z0-9-]+" placeholder="CN-10"><label>Docente responsable</label><select name="teacher_id" required><option value="">Selecciona docente</option><% users.filter(u=>u.role==='docente'&&u.active).forEach(u=>{ %><option value="<%=u.id%>"><%=u.full_name%></option><% }) %></select><button class="btn btn-primary" type="submit">Crear curso</button></form></div>
<div class="panel"><div class="panel-heading"><div><h2>Matricular estudiante</h2><p>Vincula un estudiante a un curso existente.</p></div></div><form method="post" action="/administrador/matriculas/guardar" class="form-stack" data-validate><label>Curso</label><select name="course_id" required><option value="">Selecciona curso</option><% courses.forEach(c=>{ %><option value="<%=c.id%>"><%=c.name%> · <%=c.code%></option><% }) %></select><label>Estudiante</label><select name="student_id" required><option value="">Selecciona estudiante</option><% users.filter(u=>u.role==='estudiante'&&u.active).forEach(u=>{ %><option value="<%=u.id%>"><%=u.full_name%></option><% }) %></select><button class="btn btn-primary" type="submit">Guardar matrícula</button></form></div></section>
<section class="panel"><div class="panel-heading"><div><h2>Cursos del sistema</h2><p>Vista general de cursos y matrículas.</p></div></div><div class="table-wrap"><table><thead><tr><th>Curso</th><th>Código</th><th>Docente</th><th>Estudiantes</th></tr></thead><tbody><% courses.forEach(c=>{ %><tr><td><b><%=c.name%></b></td><td><%=c.code%></td><td><%=c.teacher_name||'Sin asignar'%></td><td><%=c.students%></td></tr><% }) %></tbody></table></div></section>
<%- include("partials/footer") %>
