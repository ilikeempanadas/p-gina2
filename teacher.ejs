<%- include("partials/header", {title}) %>
<section class="dashboard-head"><div><span class="eyebrow">PANEL DOCENTE</span><h1>Hola, <span><%= user.full_name.split(" ")[0] %>.</span></h1><p>Gestiona tus cursos y mantén las calificaciones al día.</p></div><a class="btn btn-primary" href="/docente/notas/nueva">＋ Registrar nota</a></section>
<div class="stats-grid"><article class="stat-card"><span class="stat-icon">▤</span><small>Mis cursos</small><strong><%= courses.length %></strong><span class="stat-caption">Cursos asignados</span></article><article class="stat-card"><span class="stat-icon purple-icon">♙</span><small>Estudiantes</small><strong><%= courses.reduce((sum,c)=>sum+Number(c.students),0) %></strong><span class="stat-caption">Matrículas en mis cursos</span></article><article class="stat-card"><span class="stat-icon orange-icon">✓</span><small>Notas recientes</small><strong><%= grades.length %></strong><span class="stat-caption">Últimos registros</span></article></div>
<section class="panel"><div class="panel-heading"><div><h2>Mis cursos</h2><p>Materias que tienes asignadas.</p></div></div>
<% if (!courses.length) { %><div class="empty-state">Todavía no tienes cursos asignados. Pídele al administrador que te asigne uno.</div><% } else { %><div class="course-grid"><% courses.forEach(c => { %><article class="course-card"><div class="course-symbol">▤</div><span class="course-code"><%= c.code %></span><h3><%= c.name %></h3><p><%= c.students %> estudiante(s) matriculado(s)</p></article><% }) %></div><% } %></section>
<section class="panel"><div class="panel-heading"><div><h2>Calificaciones recientes</h2><p>Actualiza una nota cuando lo necesites.</p></div><a class="text-link" href="/docente/notas/nueva">+ Añadir nota</a></div>
<% if (!grades.length) { %><div class="empty-state">Aún no hay notas registradas.</div><% } else { %><div class="table-wrap"><table><thead><tr><th>Estudiante</th><th>Curso</th><th>Actividad</th><th>Nota</th><th>Actualizada</th><th></th></tr></thead><tbody><% grades.forEach(g => { %><tr><td><b><%= g.student_name %></b></td><td><%= g.course_name %></td><td><%= g.assessment %></td><td><span class="grade-pill <%= Number(g.score)>=3 ? 'grade-good' : 'grade-low' %>"><%= Number(g.score).toFixed(2) %></span></td><td><%= new Date(g.updated_at).toLocaleDateString('es-CO') %></td><td><a class="text-link" href="/docente/notas/<%= g.id %>/editar">Editar</a></td></tr><% }) %></tbody></table></div><% } %></section>
<%- include("partials/footer") %>
