# Copia este archivo como .env y completa los valores.
NODE_ENV=development
PORT=3000
# PostgreSQL local:
DATABASE_URL=postgres://postgres:tu_clave@localhost:5432/saga_notas
# En Render, activa Internal Database URL y usa SSL según la guía del README.
SESSION_SECRET=cambia-esto-por-una-clave-aleatoria-larga-de-al-menos-32-caracteres
# Solo para la primera inicialización. En producción cambia la contraseña después de entrar.
SEED_DEMO_USERS=true
