<%- include("partials/header", {title}) %>
<section class="dashboard-head"><div><span class="eyebrow">PANEL ESTUDIANTE</span><h1>Tu progreso, <span>a la vista.</span></h1><p>Hola, <%= user.full_name %>. Aquí puedes consultar tus calificaciones e historial.</p></div><div class="student-badge">▣ Historial académico</div></section>
<div class="stats-grid"><article class="stat-card"><span class="stat-icon">◉</span><small>Promedio de notas</small><strong><%= avg %></strong><span class="stat-caption">Sobre una escala de 5.00</span></article><article class="stat-card"><span class="stat-icon purple-icon">▤</span><small>Materias matriculadas</small><strong><%= courses.length %></strong><span class="stat-caption">Cursos activos</span></article><article class="stat-card"><span class="stat-icon orange-icon">✓</span><small>Evaluaciones registradas</small><strong><%= grades.length %></strong><span class="stat-caption">Notas en tu historial</span></article></div>
<section class="panel"><div class="panel-heading"><div><h2>Mis calificaciones</h2><p>Consulta tus notas y las observaciones de cada actividad.</p></div><span class="read-only-label">Solo lectura</span></div>
<% if (!grades.length) { %><div class="empty-state">Todavía no tienes calificaciones registradas.</div><% } else { %><div class="table-wrap"><table><thead><tr><th>Curso</th><th>Actividad</th><th>Calificación</th><th>Observaciones</th><th>Fecha</th></tr></thead><tbody><% grades.forEach(g => { %><tr><td><b><%= g.course_name %></b><small class="table-sub"><%= g.code %></small></td><td><%= g.assessment %></td><td><span class="grade-pill <%= Number(g.score)>=3 ? 'grade-good' : 'grade-low' %>"><%= Number(g.score).toFixed(2) %></span></td><td><%= g.notes || "—" %></td><td><%= new Date(g.updated_at).toLocaleDateString('es-CO') %></td></tr><% }) %></tbody></table></div><% } %></section>
<section class="panel"><div class="panel-heading"><div><h2>Mis materias</h2><p>Materias en las que estás matriculado/a.</p></div></div><div class="course-grid"><% if (!courses.length) { %><div class="empty-state">Aún no tienes materias asignadas.</div><% } %><% courses.forEach(c => { %><article class="course-card"><div class="course-symbol">▤</div><span class="course-code"><%= c.code %></span><h3><%= c.name %></h3><p>Materia matriculada</p></article><% }) %></div></section>
<%- include("partials/footer") %>
